# Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control

# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID – shown on the General Information page
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Your HCC Discord server (guild) ID – right-click server icon → Copy Server ID
DISCORD_GUILD_ID=your_hcc_discord_guild_id_here

# Channel IDs (right-click a channel → Copy Channel ID)
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=your_announcements_channel_id_here
DISCORD_QUIZ_CHANNEL_ID=your_quiz_channel_id_here
DISCORD_LEADERBOARD_CHANNEL_ID=your_leaderboard_channel_id_here
DISCORD_LOGS_CHANNEL_ID=your_logs_channel_id_here
DISCORD_GENERAL_CHANNEL_ID=your_general_channel_id_here

# Test channel for staging/simulation tests (never posts to production)
TEST_CHANNEL_ID=1567916304118063124

# ─── Supabase (Phase 2) ───────────────────────────────────────────────────────
# Project URL from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key (safe for client-side use)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# service_role key (keep SECRET – server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Timezone for cron scheduling (e.g. Asia/Kolkata)
TZ=Asia/Kolkata

# Daily quiz post time in 24-hour format (HH:MM)
QUIZ_POST_TIME=09:00

# Daily timed session countdown and question timer (seconds)
QUIZ_START_COUNTDOWN_SECONDS=30
QUIZ_QUESTION_TIME_SECONDS=15

# Administrator Discord role name (must match your server exactly)
ADMIN_ROLE_NAME=HCC Admin