{
  "name": "hcc-autoengage",
  "version": "1.0.0",
  "description": "HCC AutoEngage – Discord automation bot for HackerRank Campus Crew",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs hcc-autoengage",
    "deploy-commands": "node src/scripts/deployCommands.js",
    "lint": "node --check src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "hackerrank",
    "campus-crew",
    "community"
  ],
  "author": "HackerRank Campus Crew",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@supabase/supabase-js": "^2.119.0",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "node-cron": "^4.6.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
